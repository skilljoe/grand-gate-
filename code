<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Grand Gate | Mega-Project Procurement</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700;800&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    },
                    colors: {
                        brand: {
                            zinc: '#09090b', // Deep industrial black
                            steel: '#334155', // Steel gray
                            accent: '#f59e0b', // Caution amber/yellow
                            blue: '#0284c7', // Blueprint blue
                        }
                    }
                }
            }
        }
    </script>
    <style>
        body {
            background-color: #09090b;
            color: #f8fafc;
            -webkit-font-smoothing: antialiased;
        }
        /* Industrial grid background */
        .bg-grid-pattern {
            background-image: 
                linear-gradient(to right, rgba(255,255,255,0.03) 1px, transparent 1px),
                linear-gradient(to bottom, rgba(255,255,255,0.03) 1px, transparent 1px);
            background-size: 40px 40px;
        }
        .text-gradient {
            background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        .btn-glow:hover {
            box-shadow: 0 0 20px rgba(245, 158, 11, 0.4);
        }
    </style>
</head>
<body class="flex flex-col min-h-screen bg-brand-zinc relative">
    <!-- Background Texture -->
    <div class="fixed inset-0 bg-grid-pattern pointer-events-none z-0"></div>
    <div class="fixed top-0 inset-x-0 h-96 bg-gradient-to-b from-brand-blue/10 to-transparent pointer-events-none z-0"></div>

    <nav class="w-full bg-brand-zinc/80 backdrop-blur-md fixed top-0 z-50 border-b border-zinc-800">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-20">
                <div class="flex-shrink-0 flex items-center gap-3">
                    <!-- Grand Gate Logo Icon -->
                    <div class="w-10 h-10 border-2 border-brand-accent flex items-center justify-center rounded-sm">
                        <div class="w-6 h-6 border border-brand-accent transform rotate-45"></div>
                    </div>
                    <span class="font-bold text-2xl tracking-tighter text-white uppercase">Grand<span class="text-brand-accent">Gate</span></span>
                </div>
                <div>
                    <a href="#apply" class="bg-brand-accent text-zinc-950 font-bold py-2.5 px-6 rounded-sm hover:bg-amber-400 transition-colors btn-glow text-sm uppercase tracking-wide">
                        Join Roster
                    </a>
                </div>
            </div>
        </div>
    </nav>

    <main class="flex-grow pt-20 relative z-10">
        <section class="relative pt-24 pb-32 overflow-hidden">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
                <div class="text-center max-w-4xl mx-auto">
                    <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-brand-accent/10 border border-brand-accent/20 text-brand-accent text-xs font-bold uppercase tracking-wider mb-8">
                        <span class="w-2 h-2 rounded-full bg-brand-accent animate-pulse"></span>
                        Procuring Tier 2 Trades for 2026/2027
                    </div>
                    <h1 class="text-5xl md:text-6xl lg:text-7xl font-extrabold tracking-tight mb-8 leading-tight">
                        Unlock Capacity on Canada's <br/>
                        <span class="text-gradient">Mega-Projects</span>
                    </h1>
                    <p class="mt-4 text-xl text-zinc-400 mb-10 max-w-3xl mx-auto leading-relaxed">
                        We are the digital bridge for mid-market capacity. We bypass the public RFPs and place your capability statement directly on the desks of the Tier 1 EPCs building the next wave of industrial infrastructure.
                    </p>
                    <div class="flex flex-col sm:flex-row justify-center gap-4">
                        <a href="#apply" class="bg-brand-accent text-zinc-950 font-bold text-lg py-4 px-8 rounded-sm hover:bg-amber-400 transition-all btn-glow uppercase tracking-wide">
                            Submit Capability Statement
                        </a>
                    </div>
                </div>
            </div>
        </section>

        <section class="py-24 bg-zinc-900/50 border-t border-b border-zinc-800">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="text-center mb-16">
                    <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">The Grand Gate Brokerage Advantage</h2>
                    <div class="w-16 h-1 bg-brand-accent mx-auto mt-6"></div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                    <!-- Prop 1 -->
                    <div class="bg-brand-zinc border border-zinc-800 p-8 rounded-sm hover:border-brand-accent/50 transition-colors group">
                        <div class="w-14 h-14 bg-zinc-800 border border-zinc-700 flex items-center justify-center mb-6 group-hover:border-brand-accent transition-colors">
                            <svg class="w-7 h-7 text-brand-blue group-hover:text-brand-accent transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
                            </svg>
                        </div>
                        <h3 class="text-xl font-bold text-white mb-3">Direct EPC Access</h3>
                        <p class="text-zinc-400 leading-relaxed text-sm">We maintain direct relationships with Project Directors. Your profile bypasses standard government tender portals and goes straight to decision-makers.</p>
                    </div>

                    <!-- Prop 2 -->
                    <div class="bg-brand-zinc border border-zinc-800 p-8 rounded-sm hover:border-brand-accent/50 transition-colors group relative overflow-hidden">
                        <div class="absolute top-0 right-0 w-16 h-16 bg-brand-accent/10 transform rotate-45 translate-x-8 -translate-y-8 group-hover:bg-brand-accent/20 transition-colors"></div>
                        <div class="w-14 h-14 bg-zinc-800 border border-zinc-700 flex items-center justify-center mb-6 group-hover:border-brand-accent transition-colors">
                            <svg class="w-7 h-7 text-brand-blue group-hover:text-brand-accent transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                            </svg>
                        </div>
                        <h3 class="text-xl font-bold text-white mb-3">Zero Upfront Risk</h3>
                        <p class="text-zinc-400 leading-relaxed text-sm">No software subscriptions. No pay-to-play listing fees. We evaluate your capability matrix and onboard you at zero cost to your firm.</p>
                    </div>

                    <!-- Prop 3 -->
                    <div class="bg-brand-zinc border border-zinc-800 p-8 rounded-sm hover:border-brand-accent/50 transition-colors group">
                        <div class="w-14 h-14 bg-zinc-800 border border-zinc-700 flex items-center justify-center mb-6 group-hover:border-brand-accent transition-colors">
                            <svg class="w-7 h-7 text-brand-blue group-hover:text-brand-accent transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                            </svg>
                        </div>
                        <h3 class="text-xl font-bold text-white mb-3">Success-Based (2% Fee)</h3>
                        <p class="text-zinc-400 leading-relaxed text-sm">Our interests are aligned. We operate on a standard commercial brokerage NCNDA. You only pay a 2% finder's fee <em>after</em> you sign a contract.</p>
                    </div>
                </div>
            </div>
        </section>

        <section id="apply" class="py-24 relative">
            <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="bg-zinc-900 border-2 border-zinc-800 rounded-sm shadow-2xl relative">
                    
                    <!-- Form Header -->
                    <div class="p-8 border-b border-zinc-800 bg-zinc-950 flex justify-between items-center">
                        <div>
                            <h2 class="text-2xl font-bold text-white uppercase tracking-wide">Vendor Intake Form</h2>
                            <p class="text-zinc-500 text-sm mt-1">Confidential Capability Submission</p>
                        </div>
                        <div class="hidden sm:block">
                            <svg class="w-12 h-12 text-zinc-800" fill="currentColor" viewBox="0 0 24 24"><path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zM9 17H7v-7h2v7zm4 0h-2V7h2v10zm4 0h-2v-4h2v4z"/></svg>
                        </div>
                    </div>

                    <div class="p-8">
                        <form action="https://formsubmit.co/joecallou@gmail.com" method="POST" class="space-y-6">
                            <!-- FormSubmit Configurations -->
                            <input type="text" name="_honey" style="display:none">
                            <input type="hidden" name="_captcha" value="false">

                            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                <div>
                                    <label for="companyName" class="block text-xs font-bold text-zinc-400 uppercase tracking-wider mb-2">Company Name</label>
                                    <input type="text" id="companyName" name="Company Name" required class="w-full bg-zinc-950 border border-zinc-700 rounded-none px-4 py-3 text-white focus:outline-none focus:border-brand-accent transition-colors">
                                </div>
                                <div>
                                    <label for="email" class="block text-xs font-bold text-zinc-400 uppercase tracking-wider mb-2">Contact Email</label>
                                    <input type="email" id="email" name="Email" required class="w-full bg-zinc-950 border border-zinc-700 rounded-none px-4 py-3 text-white focus:outline-none focus:border-brand-accent transition-colors">
                                </div>
                            </div>

                            <div>
                                <label for="tradeSpecialty" class="block text-xs font-bold text-zinc-400 uppercase tracking-wider mb-2">Primary Trade / Service</label>
                                <select id="tradeSpecialty" name="Primary Trade / Service" required class="w-full bg-zinc-950 border border-zinc-700 rounded-none px-4 py-3 text-white focus:outline-none focus:border-brand-accent transition-colors appearance-none cursor-pointer">
                                    <option value="" disabled selected>Select Discipline...</option>
                                    <option value="Modular Camp Fabrication">Modular Camp Fabrication</option>
                                    <option value="Marine Logistics & Barging">Marine Logistics & Barging</option>
                                    <option value="Heavy Civil & Earthworks">Heavy Civil & Earthworks</option>
                                    <option value="Transmission & Electrical">Transmission & Electrical</option>
                                    <option value="Other">Other / Specialty</option>
                                </select>
                            </div>

                            <div>
                                <label for="capacity" class="block text-xs font-bold text-zinc-400 uppercase tracking-wider mb-2">Current Capacity for Q4</label>
                                <textarea id="capacity" name="Current Capacity for Q4" rows="3" required class="w-full bg-zinc-950 border border-zinc-700 rounded-none px-4 py-3 text-white focus:outline-none focus:border-brand-accent transition-colors" placeholder="Briefly describe your crew size or asset availability..."></textarea>
                            </div>

                            <div class="pt-4">
                                <button type="submit" class="w-full bg-brand-accent text-zinc-950 font-bold text-lg py-4 hover:bg-amber-400 transition-all uppercase tracking-widest shadow-[0_0_15px_rgba(245,158,11,0.2)] hover:shadow-[0_0_25px_rgba(245,158,11,0.5)] flex justify-center items-center gap-3">
                                    Submit Capability Profile
                                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
                                </button>
                                <p class="text-center text-zinc-600 text-xs mt-3 uppercase tracking-wider">Submitting implies agreement to standard NCNDA terms.</p>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <footer class="bg-zinc-950 py-10 border-t border-zinc-900 mt-auto relative z-10">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row justify-between items-center gap-4">
            <div class="flex items-center gap-2">
                <div class="w-6 h-6 border-2 border-zinc-700 flex items-center justify-center rounded-sm">
                    <div class="w-3 h-3 border border-zinc-700 transform rotate-45"></div>
                </div>
                <span class="font-bold text-lg text-zinc-500 uppercase tracking-wider">Grand<span class="text-zinc-700">Gate</span></span>
            </div>
            <div class="text-zinc-600 text-xs text-center md:text-right uppercase tracking-wider">
                <p>Industrial Brokerage & Procurement Matchmaking.</p>
                <p class="mt-1">&copy; 2026 Grand Gate. All rights reserved.</p>
            </div>
        </div>
    </footer>
</body>
</html>